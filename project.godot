; Engine configuration file.
; Paperstrike — Godot 4.x. Main scene is the main menu.

config_version=5

[application]

config/name="Paperstrike"
config/description="A small single-player 2.5D first-person shooter with a paper and cardboard look."
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameSession="*res://scripts/autoload/game_session.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[rendering]

renderer/rendering_method="forward_plus"
