[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/pause_menu.gd" id="1"]

[node name="PauseMenu" type="CanvasLayer"]
process_mode = 3
layer = 20
script = ExtResource("1")

[node name="Dim" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.05, 0.04, 0.03, 0.65)

[node name="Panel" type="PanelContainer" parent="."]
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -170.0
offset_top = -200.0
offset_right = 170.0
offset_bottom = 200.0

[node name="VBox" type="VBoxContainer" parent="Panel"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="Panel/VBox"]
layout_mode = 2
text = "PAUSED"
horizontal_alignment = 1

[node name="Resume" type="Button" parent="Panel/VBox"]
layout_mode = 2
text = "Resume"

[node name="Restart" type="Button" parent="Panel/VBox"]
layout_mode = 2
text = "Restart checkpoint"

[node name="Settings" type="Button" parent="Panel/VBox"]
layout_mode = 2
text = "Settings"

[node name="Menu" type="Button" parent="Panel/VBox"]
layout_mode = 2
text = "Return to main menu"

[node name="SettingsBox" type="VBoxContainer" parent="Panel/VBox"]
visible = false
layout_mode = 2
theme_override_constants/separation = 6

[node name="SensLabel" type="Label" parent="Panel/VBox/SettingsBox"]
layout_mode = 2
text = "Sensitivity"

[node name="Sensitivity" type="HSlider" parent="Panel/VBox/SettingsBox"]
layout_mode = 2
min_value = 0.4
max_value = 2.0
step = 0.05
value = 1.0

[node name="VolLabel" type="Label" parent="Panel/VBox/SettingsBox"]
layout_mode = 2
text = "Volume"

[node name="Volume" type="HSlider" parent="Panel/VBox/SettingsBox"]
layout_mode = 2
max_value = 1.0
step = 0.05
value = 1.0

[connection signal="pressed" from="Panel/VBox/Resume" to="." method="_on_resume"]
[connection signal="pressed" from="Panel/VBox/Restart" to="." method="_on_restart"]
[connection signal="pressed" from="Panel/VBox/Settings" to="." method="_on_settings"]
[connection signal="pressed" from="Panel/VBox/Menu" to="." method="_on_menu"]
[connection signal="value_changed" from="Panel/VBox/SettingsBox/Sensitivity" to="." method="_on_sensitivity"]
[connection signal="value_changed" from="Panel/VBox/SettingsBox/Volume" to="." method="_on_volume"]
